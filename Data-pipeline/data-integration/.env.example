# PostgreSQL Database Connection
DATABASE_URL=postgresql://postgres:password@localhost:5432/space_legacy

# Alternatively, set individual parameters:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=space_legacy
# DB_USER=postgres
# DB_PASSWORD=your_password

# Seeding Options
BATCH_SIZE=500
ON_CONFLICT_ACTION=DO NOTHING
DB_CONNECT_TIMEOUT=5
